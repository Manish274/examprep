# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── Postgres ────────────────────────────────────────────────
POSTGRES_USER=examprep
POSTGRES_PASSWORD=examprep_dev_password
POSTGRES_DB=examprep
POSTGRES_PORT=5432
DATABASE_URL=postgresql://examprep:examprep_dev_password@localhost:5432/examprep

# ── Redis ───────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Qdrant ──────────────────────────────────────────────────
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=examprep_chunks

# ── Services ────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
RAG_SERVICE_URL=http://localhost:8000
RAG_SERVICE_PORT=8000
# Shared secret for api/worker -> rag service calls
INTERNAL_SERVICE_TOKEN=dev_internal_token_change_me

# ── Auth ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_chars_long
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_chars_long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Storage ─────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
MAX_UPLOAD_BYTES=52428800

# ── Providers (key supplied later) ──────────────────────────
# Leave GEMINI_API_KEY empty to run entirely on mock providers.
GEMINI_API_KEY=
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash
LLM_UTILITY_MODEL=gemini-2.5-flash-lite
RERANKER_PROVIDER=noop
JINA_API_KEY=

# ── Rate limiting against free tiers ────────────────────────
EMBEDDING_MAX_RPM=100
EMBEDDING_BATCH_SIZE=64
LLM_MAX_RPM=15

# ── Retrieval defaults ──────────────────────────────────────
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_DENSE_TOP_K=50
RETRIEVAL_SPARSE_TOP_K=50
RRF_K=60
RERANK_TOP_N=25
CONTEXT_TOP_N=8
CONTEXT_MAX_TOKENS=5000

# ── Observability ───────────────────────────────────────────
TRACER=postgres
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
