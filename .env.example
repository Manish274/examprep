# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── Postgres ────────────────────────────────────────────────
POSTGRES_USER=examprep
POSTGRES_PASSWORD=examprep_dev_password
POSTGRES_DB=examprep
POSTGRES_PORT=5432
DATABASE_URL=postgresql://examprep:examprep_dev_password@localhost:5432/examprep

# ── Redis ───────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Qdrant ──────────────────────────────────────────────────
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=examprep_chunks

# ── Services ────────────────────────────────────────────────
API_PORT=3001
# :: accepts IPv4 and IPv6. With 0.0.0.0, a client resolving localhost to ::1
# (Windows does, first) waits about two seconds before falling back.
API_HOST=::
# The address uvicorn binds in development, not localhost, for the same reason.
RAG_SERVICE_URL=http://127.0.0.1:8000
RAG_SERVICE_PORT=8000
# Shared secret for api/worker -> rag service calls
INTERNAL_SERVICE_TOKEN=dev_internal_token_change_me
# Documents the worker processes at once
WORKER_CONCURRENCY=2

# ── Web app ─────────────────────────────────────────────────
WEB_PORT=3000
# Where the browser finds the API, and the one origin the API accepts.
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# ── Visits ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_chars_long
ACCESS_TOKEN_TTL=15m
# An abandoned visit, and everything uploaded in it, is deleted once its
# refresh tokens lapse.
REFRESH_TOKEN_TTL_DAYS=30

# ── Storage ─────────────────────────────────────────────────
STORAGE_LOCAL_PATH=./storage/uploads
MAX_UPLOAD_BYTES=52428800

# ── Providers ───────────────────────────────────────────────
# Leave GEMINI_API_KEY empty and the providers on mock/noop to run with no
# credentials at all. The Gemini 2.5 family is 404 for new keys -- use the
# 3.x models below.
GEMINI_API_KEY=
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=3072
LLM_PROVIDER=mock
LLM_MODEL=gemini-3.8-flash
LLM_UTILITY_MODEL=gemini-3.5-flash-lite
# Reads content out of images: screenshotted tables, pasted formulas,
# diagrams, and scanned PDF pages with no text layer. 'noop' disables it.
VISION_PROVIDER=noop
VISION_MODEL=gemini-3.5-flash-lite
VISION_MAX_RPM=15
VISION_MIN_PIXELS=40000
VISION_MAX_IMAGES=40

# noop, jina or gemini_listwise. Only jina's scores are calibrated, which the
# refusal recheck and the off-topic skip below depend on.
RERANKER_PROVIDER=noop
JINA_API_KEY=
RERANKER_MAX_RPM=60

# ── Rate limiting against free tiers ────────────────────────
EMBEDDING_MAX_RPM=100
EMBEDDING_BATCH_SIZE=64
LLM_MAX_RPM=15

# ── Retrieval ───────────────────────────────────────────────
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_TOKENS=64
RETRIEVAL_DENSE_TOP_K=50
RETRIEVAL_SPARSE_TOP_K=50
RRF_K=60
RERANK_TOP_N=25
CONTEXT_TOP_N=8
CONTEXT_MAX_TOKENS=5000

# ── Chat ────────────────────────────────────────────────────
# Measured on a real deck with the Jina reranker; see services/rag/app/config.py
# before changing them.
CHAT_HISTORY_TURNS=8
CHAT_HISTORY_MAX_TOKENS=1500
CHAT_RECHECK_MIN_RELEVANCE=0.2
CHAT_OFF_TOPIC_MAX_SIMILARITY=0.55
CHAT_OFF_TOPIC_MAX_RELEVANCE=0.10
CHAT_OVERVIEW_MAX_CHUNKS=24
CHAT_OVERVIEW_MAX_TOKENS=12000

# ── Observability ───────────────────────────────────────────
# postgres, langfuse, postgres,langfuse, memory or none
TRACER=postgres
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
